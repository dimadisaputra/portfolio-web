---
import { OTHER_FACE, faceHref, t, type Face, type Lang } from "../i18n";
import { NAME, SOCIAL } from "../data/site";

interface Props {
  face: Face;
  lang: Lang;
}

const { face, lang } = Astro.props;
const i = t(lang);
const other = OTHER_FACE[face];
---

<footer class="mt-32 border-t border-rule">
  <div class="px-[clamp(1rem,4vw,2.5rem)] py-16">
    {/* The cross-link is the whole point of the site: the other half of the
        same person, one click away. */}
    <a href={faceHref(other, lang, "")} class="cross" data-cursor="→">
      <span class="label">{i.common.otherFace}</span>
      <span class="display cross-title">{i.faces[other].role}</span>
    </a>

    <div
      class="mt-16 flex flex-wrap items-end justify-between gap-x-10 gap-y-8"
    >
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {
          SOCIAL.map((s) => (
            <li>
              <a
                href={s.url}
                target={s.url.startsWith("mailto") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="social"
              >
                {s.label}
                <span class="social-handle">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="text-right">
        <p class="label">
          © {new Date().getFullYear()} {NAME}. {i.common.rights}
        </p>
        <p class="label mt-1 opacity-60">{i.common.builtWith}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .cross {
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }
  .cross-title {
    font-size: clamp(2.5rem, 9vw, 6.5rem);
    transition: color 0.35s;
  }
  .cross:hover .cross-title {
    color: var(--accent);
  }

  .social {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
    color: inherit;
  }
  .social-handle {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .social:hover .social-handle {
    color: var(--accent);
  }
</style>
