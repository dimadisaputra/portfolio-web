---
import {
  OTHER_FACE,
  OTHER_LANG,
  faceHref,
  href,
  subPath,
  t,
  type Face,
  type Lang,
} from "../i18n";

interface Props {
  face: Face;
  lang: Lang;
}

const { face, lang } = Astro.props;
const i = t(lang);
const sub = subPath(Astro.url.pathname);

const links = [
  { label: i.nav.work, to: "/work" },
  { label: i.nav.about, to: "/about" },
  { label: i.nav.cv, to: "/cv" },
  { label: i.nav.contact, to: "/contact" },
];

const isActive = (to: string) => sub === to || sub.startsWith(`${to}/`);
---

<header class="nav">
  <a href={href(face, lang, "")} class="nav-mark" data-cursor="Home">
    <span class="nav-mark-initials">DAS</span>
    <span class="nav-mark-role">{i.faces[face].role}</span>
  </a>

  <nav class="nav-links" aria-label={i.nav.menu}>
    {
      links.map((l) => (
        <a
          href={href(face, lang, l.to)}
          class="nav-link"
          aria-current={isActive(l.to) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="nav-toggles">
    {/* The face switch: same page, other discipline. */}
    <a
      href={faceHref(OTHER_FACE[face], lang, sub)}
      class="face-switch"
      data-cursor={i.faces[OTHER_FACE[face]].role}
      title={i.faces[OTHER_FACE[face]].role}
    >
      <span class="face-switch-on">{face.toUpperCase()}</span>
      <span class="face-switch-off">{OTHER_FACE[face].toUpperCase()}</span>
    </a>

    <a
      href={href(face, OTHER_LANG[lang], sub)}
      class="lang-switch"
      lang={OTHER_LANG[lang]}
      hreflang={OTHER_LANG[lang]}
    >
      {t(OTHER_LANG[lang]).meta.short}
    </a>

    {/* Native popover — no JS, and it closes itself on navigation. */}
    <button class="menu-btn" popovertarget="nav-menu">{i.nav.menu}</button>
  </div>
</header>

{/* Outside <header> on purpose: the nav uses mix-blend-mode, and the menu
    must render as an opaque surface. */}
<div id="nav-menu" popover class="menu-panel">
  {
    links.map((l) => (
      <a href={href(face, lang, l.to)} class="menu-link display">
        {l.label}
      </a>
    ))
  }
  <button
    class="menu-close label"
    popovertarget="nav-menu"
    popovertargetaction="hide"
  >
    {i.nav.close}
  </button>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.125rem clamp(1rem, 4vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    mix-blend-mode: difference;
    color: #fff;
  }
  /* mix-blend-mode gives readable contrast over both faces and over any
     section the nav happens to be floating above, without a backdrop. */

  .nav a {
    color: inherit;
    text-decoration: none;
  }

  .nav-mark {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }
  .nav-mark-initials {
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .nav-mark-role {
    opacity: 0.55;
  }

  .nav-links {
    display: none;
    gap: 1.75rem;
  }
  .nav-link {
    position: relative;
    padding-block: 0.25rem;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-toggles {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .face-switch {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.625rem;
    border: 1px solid currentColor;
    font-weight: 700;
  }
  .face-switch-off {
    opacity: 0.4;
  }
  .face-switch:hover .face-switch-off {
    opacity: 1;
  }
  .face-switch:hover .face-switch-on {
    opacity: 0.4;
  }
  .face-switch-on,
  .face-switch-off {
    transition: opacity 0.3s;
  }

  .lang-switch {
    padding: 0.3125rem 0.5rem;
    opacity: 0.6;
  }
  .lang-switch:hover {
    opacity: 1;
  }

  .menu-btn {
    padding: 0.3125rem 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .menu-panel {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(4rem, 14vh, 8rem) clamp(1rem, 6vw, 3rem);
    border: 0;
    background: var(--bg);
    color: var(--fg);
  }
  /* Only when open — a bare `display: flex` would override the UA rule that
     keeps a closed popover hidden. */
  .menu-panel:popover-open {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }
  .menu-link {
    font-size: clamp(2.75rem, 13vw, 5rem);
    text-decoration: none;
    color: inherit;
  }
  .menu-link:hover {
    color: var(--accent);
  }
  .menu-close {
    margin-top: 2.5rem;
    align-self: start;
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }
    .menu-btn {
      display: none;
    }
  }
</style>
