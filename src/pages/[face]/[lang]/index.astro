---
import Base from "../../../layouts/Base.astro";
import Marquee from "../../../components/Marquee.astro";
import Pipeline from "../../../components/Pipeline.astro";
import WorkList from "../../../components/WorkList.astro";
import { facePaths, href, t, type Face, type Lang } from "../../../i18n";
import { getProjects } from "../../../lib/projects";
import { NAME } from "../../../data/site";
import { STACK } from "../../../data/stack";

export const getStaticPaths = facePaths;

const { face, lang } = Astro.params as { face: Face; lang: Lang };
const i = t(lang);
const me = i.faces[face];

const projects = await getProjects(face, lang);
const selected = projects.slice(0, 3);

// The name is split so each word can rise on its own line.
const words = NAME.split(" ");
---

<Base
  face={face}
  lang={lang}
  title={me.role}
  description={me.statement}
>
  <section class="hero">
    {face === "de" && <Pipeline />}

    <div class="hero-inner">
      <p class="hero-status label">
        <span class="pulse" aria-hidden="true"></span>
        {i.common.available}
      </p>

      <h1 class="hero-name display">
        {words.map((w) => <span class="hero-word">{w} </span>)}
      </h1>

      <div class="hero-foot">
        <p class="hero-kicker label">
          {me.kicker} — {me.role}
        </p>
        <p class="hero-statement" data-reveal="lines">{me.statement}</p>
      </div>
    </div>

    <p class="hero-scroll label" aria-hidden="true">{i.common.scroll} ↓</p>
  </section>

  <section class="section">
    <p class="lead" data-reveal="lines">{me.lead}</p>
  </section>

  <section class="section">
    <h2 class="section-title label">{i.home.capabilitiesTitle}</h2>
    <ol class="caps" data-reveal data-reveal-stagger>
      {
        me.capabilities.map((c, n) => (
          <li class="cap">
            <span class="cap-index label">{String(n + 1).padStart(2, "0")}</span>
            <h3 class="cap-title">{c.title}</h3>
            <p class="cap-body">{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title label">{i.home.selectedWork}</h2>
      <a class="section-link" href={href(face, lang, "/work")}>
        {i.common.allWork} ({projects.length}) →
      </a>
    </div>
    <WorkList projects={selected} face={face} lang={lang} />
  </section>

  <section class="section section--flush">
    <h2 class="section-title label px-edge">{i.home.stackTitle}</h2>
    <Marquee items={STACK[face]} />
  </section>

  <section class="section">
    <a class="cta" href={href(face, lang, "/contact")} data-magnetic="0.18">
      <span class="cta-title display">{i.home.ctaTitle}</span>
      <span class="cta-body">{i.home.ctaBody} — {i.home.ctaAction} →</span>
    </a>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding: 7rem clamp(1rem, 4vw, 2.5rem) 3.5rem;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 clamp(2rem, 8vh, 5rem);
    color: var(--fg);
  }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* Bleeds past the right edge on purpose — the hero is clipped, not centred. */
  .hero-name {
    margin: 0;
    font-size: clamp(3rem, 15vw, 13rem);
    text-transform: uppercase;
  }
  .hero-word {
    display: block;
  }

  .hero-foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 5vh, 3rem);
    max-width: 60ch;
  }
  .hero-kicker {
    margin: 0;
    color: var(--accent);
  }
  .hero-statement {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--muted);
  }

  .hero-scroll {
    position: absolute;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: 3.5rem;
    margin: 0;
  }

  /* ---- sections ---- */

  .section {
    padding: clamp(4rem, 12vh, 9rem) clamp(1rem, 4vw, 2.5rem);
  }
  .section--flush {
    padding-inline: 0;
  }
  .px-edge {
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-title {
    margin: 0 0 2rem;
  }
  .section-head .section-title {
    margin-bottom: 2rem;
  }
  .section-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
  }

  .lead {
    margin: 0;
    max-width: 22ch;
    font-family: var(--display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.75rem, 5vw, 4rem);
    line-height: 1.05;
  }

  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }
  .cap {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cap-index {
    display: block;
    color: var(--accent);
  }
  .cap-title {
    margin: 0.875rem 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .cap-body {
    margin: 0;
    max-width: 42ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .caps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cta {
    display: inline-flex;
    flex-direction: column;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
  }
  .cta-title {
    font-size: clamp(2rem, 7vw, 5.5rem);
    max-width: 16ch;
    transition: color 0.35s;
  }
  .cta:hover .cta-title {
    color: var(--accent);
  }
  .cta-body {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
