---
import Base from "../../../layouts/Base.astro";
import Marquee from "../../../components/Marquee.astro";
import { facePaths, href, t, type Face, type Lang } from "../../../i18n";
import { EDUCATION, formatMonth, rolesFor } from "../../../data/experience";
import { STACK } from "../../../data/stack";

export const getStaticPaths = facePaths;

const { face, lang } = Astro.params as { face: Face; lang: Lang };
const i = t(lang);
const me = i.faces[face];
const roles = rolesFor(face);
---

<Base
  face={face}
  lang={lang}
  title={`${i.about.title} — ${me.role}`}
  description={me.story[0]}
>
  <header class="head">
    <h1 class="head-title display">{i.about.title}</h1>
  </header>

  <section class="section">
    <h2 class="section-title label">{i.about.storyTitle}</h2>
    <div class="story">
      {me.story.map((p) => <p class="story-p" data-reveal="lines">{p}</p>)}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title label">{i.about.experienceTitle}</h2>
    <ol class="timeline">
      {
        roles.map((r) => (
          <li class="entry" data-reveal>
            <div class="entry-when label">
              {formatMonth(r.from, lang)} —{" "}
              {r.to ? formatMonth(r.to, lang) : i.about.present}
            </div>
            <div class="entry-what">
              <h3 class="entry-title">{r.title[lang]}</h3>
              <p class="entry-org">
                {r.company} <span class="entry-loc">· {r.location}</span>
              </p>
              <ul class="entry-points">
                {r.points[lang].map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title label">{i.about.educationTitle}</h2>
    <ol class="timeline">
      {
        EDUCATION.map((e) => (
          <li class="entry" data-reveal>
            <div class="entry-when label">{e.period}</div>
            <div class="entry-what">
              <h3 class="entry-title">{e.field[lang]}</h3>
              <p class="entry-org">
                {e.school} <span class="entry-loc">· {e.location}</span>
              </p>
              {e.gpa && (
                <p class="entry-points">
                  {i.about.gpa} {e.gpa}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section section--flush">
    <Marquee items={STACK[face]} />
  </section>

  <section class="section">
    <a class="cta" href={href(face, lang, "/cv")} data-magnetic="0.18">
      <span class="cta-title display">{i.cv.title}</span>
      <span class="cta-body">{i.cv.print} →</span>
    </a>
  </section>
</Base>

<style>
  .head {
    padding: clamp(8rem, 22vh, 14rem) clamp(1rem, 4vw, 2.5rem) 0;
  }
  .head-title {
    margin: 0;
    font-size: clamp(3.5rem, 18vw, 15rem);
    text-transform: uppercase;
  }

  .section {
    padding: clamp(3.5rem, 10vh, 7rem) clamp(1rem, 4vw, 2.5rem);
  }
  .section--flush {
    padding-inline: 0;
  }
  .section-title {
    margin: 0 0 2rem;
  }

  .story {
    max-width: 34ch;
  }
  .story-p {
    margin: 0 0 1.25rem;
    font-family: var(--display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.375rem, 3.2vw, 2.5rem);
    line-height: 1.12;
  }
  .story-p:not(:first-child) {
    color: var(--muted);
    font-family: var(--body);
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    letter-spacing: normal;
    max-width: 56ch;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .entry {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .entry-when {
    white-space: nowrap;
  }
  .entry-title {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
  }
  .entry-org {
    margin: 0.25rem 0 1rem;
    color: var(--accent);
    font-size: 0.9375rem;
  }
  .entry-loc {
    color: var(--muted);
  }
  .entry-points {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .entry-points li {
    padding-left: 1.125rem;
    text-indent: -1.125rem;
    margin-bottom: 0.375rem;
  }
  .entry-points li::before {
    content: "— ";
    color: var(--accent);
  }

  @media (min-width: 780px) {
    .entry {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .cta {
    display: inline-flex;
    flex-direction: column;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
  }
  .cta-title {
    font-size: clamp(2rem, 7vw, 5rem);
    transition: color 0.35s;
  }
  .cta:hover .cta-title {
    color: var(--accent);
  }
  .cta-body {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
