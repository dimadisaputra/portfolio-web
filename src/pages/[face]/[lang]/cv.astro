---
import Base from "../../../layouts/Base.astro";
import { facePaths, href, t, type Face, type Lang } from "../../../i18n";
import { EDUCATION, formatMonth, rolesFor } from "../../../data/experience";
import { EMAIL, NAME, SOCIAL } from "../../../data/site";
import { STACK } from "../../../data/stack";
import { getProjects, angleOf, yearOf } from "../../../lib/projects";

export const getStaticPaths = facePaths;

const { face, lang } = Astro.params as { face: Face; lang: Lang };
const i = t(lang);
const me = i.faces[face];
const roles = rolesFor(face);
const projects = (await getProjects(face, lang)).slice(0, 4);

const contactLine = [
  EMAIL,
  ...SOCIAL.filter((s) => !s.url.startsWith("mailto")).map((s) => s.handle),
].join("  ·  ");

const updated = new Date().toLocaleDateString(
  lang === "id" ? "id-ID" : "en-GB",
  { month: "long", year: "numeric" },
);
---

<Base
  face={face}
  lang={lang}
  title={`${i.cv.title} — ${me.role}`}
  description={me.cvSummary}
  bare
>
  <div class="bar">
    <a class="bar-link label" href={href(face, lang, "/about")}>← {i.nav.about}</a>
    <button class="bar-btn label" id="print">{i.cv.print}</button>
    <span class="bar-hint label">{i.cv.printHint}</span>
  </div>

  <article class="cv">
    <header class="cv-head">
      <h1 class="cv-name">{NAME}</h1>
      <p class="cv-role">{me.role}</p>
      <p class="cv-contact">{contactLine}</p>
    </header>

    <section class="cv-block">
      <h2 class="cv-h2">{i.cv.summary}</h2>
      <p class="cv-summary">{me.cvSummary}</p>
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">{i.cv.experience}</h2>
      {
        roles.map((r) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3 class="cv-item-title">
                {r.title[lang]}, {r.company}
              </h3>
              <span class="cv-item-when">
                {formatMonth(r.from, lang)} —{" "}
                {r.to ? formatMonth(r.to, lang) : i.about.present} ·{" "}
                {r.location}
              </span>
            </div>
            <ul class="cv-points">
              {r.points[lang].map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">{i.cv.selectedProjects}</h2>
      {
        projects.map((p) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3 class="cv-item-title">{p.data.title}</h3>
              <span class="cv-item-when">{yearOf(p)}</span>
            </div>
            <p class="cv-points">{angleOf(p, face)}</p>
            <p class="cv-tags">{(p.data.tags ?? []).join(" · ")}</p>
          </div>
        ))
      }
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">{i.cv.education}</h2>
      {
        EDUCATION.map((e) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3 class="cv-item-title">
                {e.field[lang]}, {e.school}
              </h3>
              <span class="cv-item-when">
                {[e.period, e.location].filter(Boolean).join(" · ")}
              </span>
            </div>
            <p class="cv-points">
              {i.about.gpa} {e.gpa}
            </p>
          </div>
        ))
      }
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">{i.cv.skills}</h2>
      <p class="cv-points">{STACK[face].join(" · ")}</p>
    </section>

    <footer class="cv-foot">
      {i.cv.updated} {updated}
    </footer>
  </article>
</Base>

<script>
  document
    .getElementById("print")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .bar-link,
  .bar-btn {
    text-decoration: none;
    background: none;
    border: 0;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .bar-btn {
    border: 1px solid currentColor;
    padding: 0.5rem 0.875rem;
  }
  .bar-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .bar-hint {
    color: var(--muted);
  }

  .cv {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) 6rem;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .cv-head {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .cv-name {
    margin: 0;
    font-family: var(--display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1;
  }
  .cv-role {
    margin: 0.5rem 0 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cv-contact {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .cv-block {
    margin-top: 2rem;
  }
  .cv-h2 {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cv-summary {
    margin: 0;
    max-width: 62ch;
  }

  .cv-item {
    margin-bottom: 1.25rem;
    break-inside: avoid;
  }
  .cv-item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .cv-item-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .cv-item-when {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .cv-points {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .cv-points li {
    padding-left: 0.875rem;
    text-indent: -0.875rem;
  }
  .cv-points li::before {
    content: "— ";
  }
  .cv-tags {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .cv-foot {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- print ----
     Forced to ink-on-paper regardless of which face you printed from: a CV
     with a black background wastes toner and reads worse. */
  @media print {
    .bar {
      display: none;
    }
    .cv {
      max-width: none;
      margin: 0;
      padding: 0;
      font-size: 10pt;
      line-height: 1.4;
      color: #000;
    }
    .cv-name,
    .cv-item-title {
      color: #000;
    }
    .cv-role,
    .cv-contact,
    .cv-h2,
    .cv-item-when,
    .cv-points,
    .cv-tags,
    .cv-foot {
      color: #333;
    }
    .cv-head,
    .cv-foot {
      border-color: #999;
    }
    .cv-block {
      margin-top: 1.25rem;
      break-inside: avoid;
    }
  }
</style>

<style is:global>
  @page {
    size: A4;
    margin: 16mm 14mm;
  }
  @media print {
    html,
    body {
      background: #fff !important;
    }
    .grain,
    .grid-overlay,
    #cursor,
    .skip-link {
      display: none !important;
    }
  }
</style>
