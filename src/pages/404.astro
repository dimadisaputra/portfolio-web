---
import Base from "../layouts/Base.astro";
import { DEFAULT_FACE, DEFAULT_LANG, faceHref, t } from "../i18n";
import { FACE_DOMAIN } from "../site-config";

// A static 404 is served for any path, so it cannot know the face at build
// time. It renders in the default face and corrects itself below.
const i = t(DEFAULT_LANG);
---

<Base
  face={DEFAULT_FACE}
  lang={DEFAULT_LANG}
  title={i.notFound.title}
  description={i.notFound.body}
  bare
>
  <section class="lost">
    <p class="label">404</p>
    <h1 class="lost-title display">{i.notFound.title}</h1>
    <p class="lost-body">{i.notFound.body}</p>
    <a
      class="lost-home label"
      id="home"
      href={faceHref(DEFAULT_FACE, DEFAULT_LANG)}
    >
      {i.notFound.home} →
    </a>
  </section>
</Base>

<script is:inline define:vars={{ FACE_DOMAIN }}>
  // Keep whichever face and language the broken URL was already in, so a dead
  // link on the SE site does not throw you onto the DE one.
  //
  // The path has two possible shapes: `/de/en/…` locally, and `/en/…` on a
  // face subdomain, where the face is in the hostname instead.
  {
    const parts = location.pathname.split("/").filter(Boolean);
    const face =
      parts[0] === "de" || parts[0] === "se"
        ? parts.shift()
        : location.hostname.split(".")[0];
    const lang = parts[0] === "en" || parts[0] === "id" ? parts[0] : "en";

    const root = document.documentElement;
    if (face === "de" || face === "se") root.dataset.face = face;
    root.lang = lang;
    root.dataset.lang = lang;

    const home = document.getElementById("home");
    if (home) {
      const f = root.dataset.face || "de";
      home.setAttribute(
        "href",
        FACE_DOMAIN ? `https://${f}.${FACE_DOMAIN}/${lang}` : `/${f}/${lang}`,
      );
    }
  }
</script>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    min-height: 100svh;
    padding: 4rem clamp(1rem, 4vw, 2.5rem);
  }
  .lost-title {
    margin: 0;
    font-size: clamp(4rem, 22vw, 18rem);
    text-transform: uppercase;
  }
  .lost-body {
    margin: 0;
    max-width: 40ch;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .lost-home {
    margin-top: 2rem;
    color: var(--accent);
    text-decoration: none;
  }
</style>
